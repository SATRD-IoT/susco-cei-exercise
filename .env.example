# Fill in your INSTRUCTOR-PROVIDED settings; these are placeholders.
# Do NOT put real credentials into the notebook, Git, or a shared ZIP.
# Keep .env local on your computer; it is excluded from Docker builds.

# Jupyter AND laptop Docker containers -> external Orion-LD gateway (JWT required).
# This gateway hides /ngsi-ld/v1; the Python client appends /entities.
# The token is supplied to each short-lived laptop container at run time.
CEI_ORION_URL=https://REPLACE_WITH_EXTERNAL_ORION_GATEWAY
CEI_ORION_MODE=external
CEI_ORION_JWT=REPLACE_WITH_TEMPORARY_ORION_JWT

# ONLY remote aeriOS edge/cloud containers -> direct internal Orion-LD.
# The laptop and its containers do NOT need access to this internal IP.
# Remote workloads append /ngsi-ld/v1/entities and use no JWT.
CEI_ORION_INTERNAL_URL=http://REPLACE_WITH_ORION_INTERNAL_IP_AND_PORT

# Jupyter / laptop -> aeriOS service API (JWT required).
CEI_AERIOS_URL=https://REPLACE_WITH_AERIOS_HOST/hlo_fe
CEI_AERIOS_JWT=REPLACE_WITH_TEMPORARY_AERIOS_JWT
CEI_EDGE_NODE_ID=urn:ngsi-ld:InfrastructureElement:REPLACE_WITH_EDGE_ID
CEI_CLOUD_NODE_ID=urn:ngsi-ld:InfrastructureElement:REPLACE_WITH_CLOUD_ID

# Remote images are published by the instructor to Docker Hub.
CEI_CPU_IMAGE_REMOTE=REPLACE_WITH_DOCKERHUB_NAMESPACE/cei-lab-cpu:0.2.0
CEI_IOT_IMAGE_REMOTE=REPLACE_WITH_DOCKERHUB_NAMESPACE/cei-lab-iot:0.3.0

# Use a different identifier for each student group (letters/digits/hyphens).
CEI_GROUP_ID=REPLACE_WITH_ASSIGNED_GROUP_ID
